# ==============================================================================
# Sentinel Memory - Environment Configuration Template
# Copy this file to .env before starting development:
#   cp .env.example .env
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite+aiosqlite:///./sentinel_memory.db
# Production / Staging PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel_memory

# Hindsight Configuration
# HINDSIGHT_MODE: "mock" (in-memory/local file simulation) or "client" (Hindsight Cloud / self-hosted daemon)
HINDSIGHT_MODE=mock
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=sentinel-incident-memory

# LLM Provider Configuration
# LLM_PROVIDER: "mock" (rule-based / deterministic simulation) or "groq" or "openai"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
