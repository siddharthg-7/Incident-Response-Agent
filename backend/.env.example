# Database Configuration (PostgreSQL / SQLite local dev)
DATABASE_URL=sqlite+aiosqlite:///./sentinel_memory.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel_memory

# Hindsight Persistent Memory Configuration
HINDSIGHT_MODE=mock
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=sentinel-incident-memory

# LLM Provider Configuration (Groq / OpenAI / Mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
